# ==============================================================================
# SRI SAI Tuition & Learning Centre - Environment Configuration
# ==============================================================================

# Client-side Variables (Vite Frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Razorpay Key ID (Public key safe for browser checkout)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ==============================================================================
# Server-Side Only / Supabase Edge Functions Secrets
# DO NOT add 'VITE_' prefix to these secret keys. Configure these in Supabase Dashboard -> Secrets.
# ==============================================================================

# Razorpay Backend Secrets
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Multi-channel Notification Provider Secrets (Optional)
EMAIL_PROVIDER_API_KEY=your_resend_or_sendgrid_api_key
WHATSAPP_PROVIDER_API_KEY=your_meta_whatsapp_cloud_api_key
SMS_PROVIDER_API_KEY=your_fast2sms_or_twilio_api_key

# ==============================================================================
# Phase 5 — AI Doubt Buddy (Edge Function Secrets)
# Configure in Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
# ==============================================================================
# Groq (Initial / Recommended Provider for ultra-fast response times):
AI_PROVIDER=groq                                     # 'groq' | 'gemini' | 'openai' | 'claude'
GROQ_API_KEY=gsk_your_groq_api_key_here              # Groq API Key (from console.groq.com)
GROQ_TEXT_MODEL=openai/gpt-oss-120b                  # Current Production text/reasoning model (or openai/gpt-oss-20b)
GROQ_VISION_MODEL=qwen/qwen3.8-27b                   # Current Production vision model (OCR, diagrams, textbook photos)

# Other optional providers:
# AI_PROVIDER=gemini                                 # Gemini provider
# AI_MODEL=gemini-1.5-flash                          # Gemini model name
# AI_API_KEY=your_gemini_or_openai_api_key_here

# Daily student quotas:
MAX_DAILY_AI_REQUESTS=50                             # Daily per-student question limit (default: 50)
MAX_IMAGE_REQUESTS=10                                # Daily per-student image analysis limit (default: 10)


